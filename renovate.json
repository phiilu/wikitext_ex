{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":semanticCommits", ":semanticCommitTypeAll(chore)"],
  "labels": ["dependencies"],
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Merge everything short of a major update once CI is green.",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "automerge": true
    },
    {
      "description": "Give a new release three days to be flagged as malicious before it is proposed.",
      "matchUpdateTypes": ["major", "minor", "patch"],
      "minimumReleaseAge": "3 days",
      "internalChecksFilter": "strict"
    },
    {
      "description": "A runtime dependency's update reaches users, so it cuts a release.",
      "matchManagers": ["mix"],
      "matchDepTypes": ["prod"],
      "semanticCommitType": "fix"
    },
    {
      "description": "Elixir is built for an OTP release, so the two move together.",
      "matchManagers": ["mise"],
      "matchDepNames": ["elixir", "erlang"],
      "groupName": "Elixir and OTP"
    }
  ]
}
